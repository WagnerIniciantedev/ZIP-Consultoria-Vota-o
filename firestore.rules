rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: assemblies
    // Document ID: {assemblyId}
    //
    // Collection: system
    // Document ID: users, logs, global, authorized_admins/{uid}
    //
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isTI() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/system/authorized_admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/system/authorized_admins/$(request.auth.uid)).data.role == 'TI';
    }

    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/system/authorized_admins/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/system/authorized_admins/$(request.auth.uid)).data.role == 'ADMIN' || 
         get(/databases/$(database)/documents/system/authorized_admins/$(request.auth.uid)).data.role == 'TI');
    }

    // System configuration and user lists
    match /system/{docId} {
      allow read: if isAuthenticated();
      
      // Allow admins to write system docs
      allow write: if isAdmin();

      // Special rule for authorizing admins
      match /authorized_admins/{uid} {
        allow read: if isAuthenticated();
        // Allow an admin to authorize another, or the master admin to authorize themselves
        allow write: if isAdmin() || 
          (isAuthenticated() && request.auth.uid == uid && 
           request.auth.token.email == "wagner1jackson@gmail.com" && request.auth.token.email_verified == true);
      }
    }

    // Assembly data
    match /assemblies/{assemblyId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      // Only TI can delete assemblies
      allow delete: if isTI();
      
      allow update: if isAdmin() || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']));
      
      match /residents_list/{unit} {
        allow get: if isAuthenticated();
        allow list, write: if isAdmin();
      }
    }
  }
}
