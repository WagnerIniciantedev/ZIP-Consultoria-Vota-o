rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: assemblies
    // Document ID: {assemblyId}
    //
    // Collection: system
    // Document ID: users, logs, global, authorized_admins/{uid}
    //
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "wagner1jackson@gmail.com" && 
         request.auth.token.email_verified == true);
    }

    function getAdminData() {
      return get(/databases/$(database)/documents/system/authorized_admins/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (isMasterAdmin() || 
         (exists(/databases/$(database)/documents/system/authorized_admins/$(request.auth.uid)) &&
          (getAdminData().role == 'ADMIN' || getAdminData().role == 'TI' || getAdminData().role == 'MASTER')));
    }

    function isTI() {
      return isAdmin() && (isMasterAdmin() || getAdminData().role == 'TI' || getAdminData().role == 'MASTER');
    }

    // System configuration and user lists
    match /system/{docId} {
      allow read: if isAuthenticated();
      
      // Allow admins to write system docs
      allow write: if isAdmin();

      // Special rule for authorizing admins
      match /authorized_admins/{uid} {
        allow read: if isAuthenticated();
        // Allow an admin to authorize another, or the master admin to authorize themselves
        // Also allow bootstrap for known usernames if authenticated
        allow write: if isAdmin() || 
          (isAuthenticated() && request.auth.uid == uid && 
           (isMasterAdmin() || 
            request.resource.data.username.lower() in [
              'admin', 'admin@zipconsultoria.com',
              'fillype.sampaio', 'fillype.sampaio@zipconsultoria.com',
              'zeferino.batista', 'zeferino.batista@zipconsultoria.com',
              'wagner.jackson', 'wagner.jackson@zipconsultoria.com'
            ]));
      }
    }

    // Connection test collection
    match /test/{docId} {
      allow read: if true;
    }

    // Assembly data
    match /assemblies/{assemblyId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      // Only TI can delete assemblies
      allow delete: if isTI();
      
      allow update: if isAdmin();
      
      // Subcollections for residents and votes
      match /{subcollection}/{docId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }
  }
}
