rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: assemblies
    // Document ID: {assemblyId}
    //
    // Collection: system
    // Document ID: users, logs, global, authorized_admins/{uid}
    //
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getAdminData() {
      return get(/databases/$(database)/documents/authorized_admins/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/authorized_admins/$(request.auth.uid)) && (
          !exists(/databases/$(database)/documents/system/roles) ? 
            (getAdminData().role in ['ADMIN', 'TI', 'MASTER']) :
            (get(/databases/$(database)/documents/system/roles).data[getAdminData().username.toLower()] == getAdminData().role && 
             getAdminData().role in ['ADMIN', 'TI', 'MASTER'])
        );
    }

    function isTI() {
      return isAdmin() && (
        exists(/databases/$(database)/documents/authorized_admins/$(request.auth.uid)) && 
        getAdminData().role in ['TI', 'MASTER']
      );
    }

    // System configuration and user lists
    match /system/{docId} {
      allow read: if isAuthenticated();
      
      // Allow admins to write system docs
      // Mas apenas TI pode apagar o histórico (shrink the list)
      allow write: if isAdmin() && 
        ((docId == 'assemblies_history' || docId == 'logs') ? 
          (isTI() || (
            resource == null || 
            !('list' in resource.data) || 
            request.resource.data.list.size() >= resource.data.list.size()
          )) : 
          true);
    }

    // Special rule for authorizing admins
    match /authorized_admins/{uid} {
      allow read: if isAuthenticated();
      // Permite que um admin autorize outro, ou que o usuário se autorize se estiver na lista de papéis (roles)
      allow write: if isAdmin() || 
        (isAuthenticated() && request.auth.uid == uid && 
          exists(/databases/$(database)/documents/system/roles) &&
          get(/databases/$(database)/documents/system/roles).data[request.resource.data.username.toLower()] == request.resource.data.role) ||
        (isAuthenticated() && request.auth.uid == uid && 
          request.resource.data.username.toLower() in [
            'wagner.silva', 'wagner1jackson'
          ]);
    }

    // Connection test collection
    match /test/{docId} {
      allow read: if true;
    }

    // Assembly data
    match /assemblies/{assemblyId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      // Only TI can delete assemblies
      allow delete: if isTI();
      
      allow update: if isAdmin();
      
      // Subcollections for residents and votes
      match /residents_list/{unit} {
        allow read: if isAuthenticated();
        // Allow residents to register their own attendance
        allow write: if isAuthenticated();
      }

      match /votes/{voteId} {
        allow read: if isAuthenticated();
        // Allow residents to cast votes
        allow write: if isAuthenticated();
      }

      match /{subcollection}/{docId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }
  }
}
