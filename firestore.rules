rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // CATCH-ALL DEFAULT DENY NET (THE FORTRESS GROUND EXCLUSION)
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // GLOBAL SECURITY PRIMITIVES AND HELPERS
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasAdminDoc() {
      return exists(/databases/$(database)/documents/authorized_admins/$(request.auth.uid));
    }

    function getAdminData() {
      return get(/databases/$(database)/documents/authorized_admins/$(request.auth.uid)).data;
    }

    // Zero Hardcoding: Dynamic verification of ADMINISTRATIVE roles (Custom Claims + Document State)
    function isTI() {
      return isAuthenticated() && (
        request.auth.token.role == 'TI' || 
        (hasAdminDoc() && getAdminData().get('role', 'NONE') == 'TI')
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role in ['ADMIN', 'TI'] ||
        (hasAdminDoc() && getAdminData().get('role', 'NONE') in ['ADMIN', 'TI'])
      );
    }

    function hasValidRoleInSystem(username, role) {
      return (username == 'wagner.silva' && role == 'TI') || (
        exists(/databases/$(database)/documents/system/roles) &&
        get(/databases/$(database)/documents/system/roles).data.get(username, 'NONE') == role
      );
    }

    // Protection against malicious document names
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_ \\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ===============================================================
    // ENTITY SCHEMAS & ATTRIBUTE VALIDATORS
    // ===============================================================

    function isValidAdmin(a) {
      return a.get('username', '') is string && a.get('username', '').size() <= 100 &&
             a.get('role', '') is string && a.get('role', '') in ['ADMIN', 'TI'] &&
             (a.get('authorizedAt', 0) is int || a.get('authorizedAt', 0) is float);
    }

    function isValidAssembly(a) {
      return a.get('name', '') is string && a.get('name', '').size() <= 128 &&
             (a.get('startTime', 0) is int || a.get('startTime', 0) is float) &&
             a.get('isActive', false) is bool;
    }

    function isValidResident(r) {
      return r.get('unit', '') is string && r.get('unit', '').size() <= 64 &&
             r.get('name', '') is string && r.get('name', '').size() <= 128 &&
             r.get('cpf', '') is string && r.get('cpf', '').size() <= 32 &&
             r.get('isDelinquent', false) is bool &&
             r.get('hasHabiteSe', false) is bool &&
             (r.get('fraction', 0.0) is float || r.get('fraction', 0.0) is int);
    }

    function isValidVote(v) {
      return v.get('pollId', '') is string && v.get('pollId', '').size() <= 128 &&
             v.get('unit', '') is string && v.get('unit', '').size() <= 64 &&
             v.get('optionId', '') is string && v.get('optionId', '').size() <= 64 &&
             (v.get('timestamp', 0) is int || v.get('timestamp', 0) is float) &&
             v.get('isDelinquentVote', false) is bool;
    }

    // ===============================================================
    // FILE PATH ROUTING SECTIONS
    // ===============================================================

    // 1. System configs and runtime environments
    match /system/{docId} {
      allow read: if isAuthenticated() && isValidId(docId);
      allow write: if isAdmin() && isValidId(docId);
    }

    // 2. Authorized Administrative RBAC (Zero-Trust)
    match /authorized_admins/{uid} {
      allow read: if isAuthenticated() && isValidId(uid);
      
      // Zero Self-Elevating: Only active TI can register or change administration profiles.
      // Bootstrap Exception / System Roles Map: Allow authorized administrators (matching /system/roles) to register their anonymous UID.
      allow create: if isAuthenticated() && isValidId(uid) && isValidAdmin(incoming()) && (
        isTI() || hasValidRoleInSystem(incoming().username, incoming().role)
      );
      // Allow administrators to update their own dynamic login stats (e.g. lastLogin) without elevating their role.
      allow update: if isAuthenticated() && isValidId(uid) && (
        isTI() || (
          request.auth.uid == uid &&
          isValidAdmin(incoming()) &&
          incoming().role == existing().role &&
          incoming().username == existing().username
        )
      );
      allow delete: if isTI() && isValidId(uid);
    }

    // 3. System latency testing channel
    match /test/{docId} {
      allow read, write: if isAuthenticated() && isValidId(docId);
    }

    // 4. Juridical Immutable Audit Logs (Client Mutation Block)
    match /audit_logs/{logId} {
      allow read: if isTI() && isValidId(logId);
      
      // Strict Anti-Tampering: No clientside writes or deletion allowed under any roles.
      // Cloud Functions (Admin SDK) bypass rules to seed this ledger safely.
      allow write, update, delete: if false;
    }

    // 5. Assemblies Management
    match /assemblies/{assemblyId} {
      allow read: if isValidId(assemblyId);
      allow create: if isAdmin() && isValidId(assemblyId) && isValidAssembly(incoming());
      allow update: if isAdmin() && isValidId(assemblyId) && isValidAssembly(incoming());
      allow delete: if isTI() && isValidId(assemblyId);

      // --- SUBCOLLECTION: Residents List (LGPD Protection Plan) ---
      match /residents_list/{unit} {
        // Scraper defense: Block list entirely for non-admins, get allowed only for self-resident claim or admin
        allow get: if isValidId(unit) && (
          isAdmin() || (
            isAuthenticated() &&
            request.auth.token.role == 'RESIDENT' &&
            request.auth.token.assemblyId == assemblyId &&
            request.auth.token.unit.lower() == unit.lower()
          )
        );
        allow list: if isAdmin();
        
        allow create, delete: if isAdmin() && isValidId(unit);

        allow update: if isValidId(unit) && (
          // Admin complete access
          (isAdmin() && isValidResident(incoming())) ||
          // Resident self-checkin/upload pipeline (securely restricted by custom claims)
          (
            isAuthenticated() &&
            request.auth.token.role == 'RESIDENT' &&
            request.auth.token.assemblyId == assemblyId &&
            request.auth.token.unit.lower() == unit.lower() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'zoomName', 'attendanceStatus', 'verificationStatus', 'documentPhotoUrl', 'selfiePhotoUrl'
            ]) &&
            incoming().get('zoomName', '') is string && incoming().get('zoomName', '').size() <= 128 &&
            incoming().get('attendanceStatus', 'NONE') in ['NONE', 'PENDING'] &&
            incoming().get('verificationStatus', 'NONE') in ['NONE', 'PENDING'] &&
            (incoming().get('documentPhotoUrl', '') == null || (incoming().get('documentPhotoUrl', '') is string && incoming().get('documentPhotoUrl', '').size() <= 1024)) &&
            (incoming().get('selfiePhotoUrl', '') == null || (incoming().get('selfiePhotoUrl', '') is string && incoming().get('selfiePhotoUrl', '').size() <= 1024))
          )
        );
      }

      // --- SUBCOLLECTION: Votes (Strict Fraud Mitigation) ---
      match /votes/{voteId} {
        // Absolute Fraud Defense: Clients cannot read or write votes directly!
        // ONLY server-side Cloud Functions or Admin dashboard can access them.
        allow read, write: if isAdmin();
      }

      // --- SUBCOLLECTION: Audit Logs (Juridical Ledger) ---
      match /audit_logs/{logId} {
        allow read, write: if isAdmin();
      }

      // --- SUBCOLLECTION: Resident Sessions ---
      match /resident_sessions/{sessionId} {
        allow read, write: if isAdmin();
      }

      // --- SUBCOLLECTION: Blocked Units ---
      match /blocked_units/{unitId} {
        allow read, write: if isAdmin();
      }

      // --- SUBCOLLECTION: Security Settings ---
      match /security_settings/{configId} {
        allow read: if isAuthenticated(); // To let client check if App Check / Token is required
        allow write: if isAdmin();
      }

      // Supporting subcollections under assemblies
      match /{subcollection}/{docId} {
        allow read: if isValidId(subcollection) && isValidId(docId) && isAuthenticated() && (
          subcollection != 'live_signals' ||
          resource.data.senderUserId == request.auth.uid ||
          resource.data.targetUserId == request.auth.uid ||
          isAdmin()
        );
        
        allow write: if isAuthenticated() && isValidId(subcollection) && isValidId(docId) && (
          // Admin rules with state machine and immutability for live_room/status
          (
            isAdmin() && (
              subcollection != 'live_room' || docId != 'status' || (
                // State Machine & Immutability validation for status
                // Existing status can be SCHEDULED, LIVE, ENDED
                (
                  // Creating status
                  !exists(/databases/$(database)/documents/assemblies/$(assemblyId)/live_room/status) &&
                  request.resource.data.status in ['SCHEDULED', 'LIVE']
                ) || (
                  // Updating status
                  exists(/databases/$(database)/documents/assemblies/$(assemblyId)/live_room/status) && (
                    // SCHEDULED -> LIVE
                    (resource.data.status == 'SCHEDULED' && request.resource.data.status == 'LIVE' &&
                     request.resource.data.get('startedAt', 0) is int &&
                     request.resource.data.startedBy == request.auth.uid) ||
                    // LIVE -> ENDED
                    (resource.data.status == 'LIVE' && request.resource.data.status == 'ENDED' &&
                     request.resource.data.get('endedAt', 0) is int &&
                     request.resource.data.endedBy == request.auth.uid &&
                     request.resource.data.get('activePublisherId', null) == null &&
                     request.resource.data.get('isSharingScreen', false) == false) ||
                    // General admin update while maintaining status terminal immutability if already ENDED
                    (resource.data.status == 'ENDED' && request.resource.data.status == 'ENDED' &&
                     request.resource.data.get('startedAt', 0) == resource.data.get('startedAt', 0) &&
                     request.resource.data.get('startedBy', '') == resource.data.get('startedBy', '') &&
                     request.resource.data.get('endedAt', 0) == resource.data.get('endedAt', 0) &&
                     request.resource.data.get('endedBy', '') == resource.data.get('endedBy', '')) ||
                    // LIVE -> LIVE (e.g. toggling screen share or publisher)
                    (resource.data.status == 'LIVE' && request.resource.data.status == 'LIVE' &&
                     request.resource.data.get('startedAt', 0) == resource.data.get('startedAt', 0) &&
                     request.resource.data.get('startedBy', '') == resource.data.get('startedBy', ''))
                  )
                )
              )
            )
          ) || (
            subcollection == 'live_participants' && docId == request.auth.uid &&
            request.resource.data.userId == request.auth.uid
          ) || (
            subcollection == 'live_chat' &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.get('message', '') is string &&
            request.resource.data.get('message', '').size() > 0 &&
            request.resource.data.get('message', '').size() <= 2000
          ) || (
            subcollection == 'live_speaker_requests' &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.get('status', 'PENDING') == 'PENDING'
          ) || (
            subcollection == 'live_signals' &&
            request.resource.data.senderUserId == request.auth.uid &&
            request.resource.data.get('type', '') in ['offer', 'answer', 'candidate']
          )
        );

        allow delete: if isAuthenticated() && isValidId(subcollection) && isValidId(docId) && (
          isAdmin() || (
            subcollection == 'live_signals' &&
            (resource.data.senderUserId == request.auth.uid || resource.data.targetUserId == request.auth.uid)
          ) || (
            subcollection == 'live_participants' && docId == request.auth.uid
          )
        );
      }
    }
  }
}
