rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: assemblies
    // Document ID: {assemblyId}
    //
    // Collection: system
    // Document ID: users, logs, global, authorized_admins/{uid}
    //
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getAdminData() {
      return get(/databases/$(database)/documents/authorized_admins/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/authorized_admins/$(request.auth.uid)) && 
        getAdminData().get('role', 'NONE') in ['ADMIN', 'TI'];
    }

    function isTI() {
      return isAdmin() && 
        getAdminData().get('role', 'NONE') == 'TI';
    }

    // System configuration and user lists
    match /system/{docId} {
      allow read: if isAuthenticated();
      
      // Allow admins to write system docs
      // Mas apenas TI pode apagar o histórico ou logs de erro
      allow write: if isAdmin() && 
        ((docId == 'assemblies_history' || docId == 'logs' || docId == 'error_logs') ? 
          (isTI() || (
            resource == null || 
            !('list' in resource.data) || 
            !('logs' in resource.data) ||
            (docId == 'error_logs' ? request.resource.data.logs.size() >= resource.data.logs.size() : request.resource.data.list.size() >= resource.data.list.size())
          )) : 
          true) ||
        // Allow any authenticated user to append to error_logs (but not clear it)
        (docId == 'error_logs' && isAuthenticated() && 
         (resource == null || (request.resource.data.logs.size() > resource.data.logs.size())));
    }

    // Special rule for authorizing admins
    match /authorized_admins/{uid} {
      allow read: if isAuthenticated();
      // Permite que um admin autorize outro, ou que o usuário se autorize se estiver na lista de papéis (roles) ou bootstrap
      allow write: if isAdmin() || 
        (isAuthenticated() && request.auth.uid == uid && (
          // Check bootstrap list
          request.resource.data.get('username', '').lower() in [
            'wagner.silva', 'admin', 'ti'
          ] ||
          // Check roles document if it exists
          (exists(/databases/$(database)/documents/system/roles) &&
           get(/databases/$(database)/documents/system/roles).data.get(request.resource.data.get('username', '').lower(), 'NONE') == request.resource.data.get('role', 'NONE'))
        ));
    }

    // Connection test collection
    match /test/{docId} {
      allow read: if true;
    }

    // Assembly data
    match /assemblies/{assemblyId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      // Only TI can delete assemblies
      allow delete: if isTI();
      
      allow update: if isAdmin();
      
      // Subcollections for residents and votes
      match /residents_list/{unit} {
        allow read: if isAuthenticated();
        // Allow residents to register their own attendance
        allow write: if isAuthenticated();
      }

      match /votes/{voteId} {
        allow read: if isAuthenticated();
        // Allow residents to cast votes
        allow write: if isAuthenticated();
      }

      match /{subcollection}/{docId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }
  }
}
